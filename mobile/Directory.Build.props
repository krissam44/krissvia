<Project>
  <!-- L'appli MAUI est hors de Krissvia.slnx (le workload MAUI n'existe ni sur la VM ni sur le Pi) : ce fichier
       remplace celui de la racine, dont le TargetFramework unique empêcherait le multi-cibles (android, windows). -->
  <PropertyGroup>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <WarningsNotAsErrors>NU1901;NU1902;NU1903;NU1904</WarningsNotAsErrors>
  </PropertyGroup>
</Project>
