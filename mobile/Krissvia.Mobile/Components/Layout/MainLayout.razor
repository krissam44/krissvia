@inherits LayoutComponentBase
@inject NavigationManager Nav

<MudThemeProvider IsDarkMode="_sombre" />
<MudPopoverProvider />
<MudDialogProvider />
<MudSnackbarProvider />

<MudLayout>
    <MudAppBar Elevation="1" Dense="true">
        <MudText Typo="Typo.h6" Style="font-weight:300;letter-spacing:1px;cursor:pointer;" @onclick="@(() => Nav.NavigateTo("/"))">Krissvia</MudText>
        <MudSpacer />
        <MudIconButton Icon="@(_sombre ? Icons.Material.Filled.LightMode : Icons.Material.Filled.DarkMode)"
                       Color="Color.Inherit" OnClick="@(() => _sombre = !_sombre)" aria-label="Thème" />
        <MudIconButton Icon="@Icons.Material.Filled.Settings" Color="Color.Inherit"
                       OnClick="@(() => Nav.NavigateTo("/reglages"))" aria-label="Connexion" />
    </MudAppBar>

    @* Un seul écran pour l'instant : la barre de navigation basse de DomoMud viendra avec le deuxième. *@
    <MudMainContent>
        <div class="pa-3">
            @Body
        </div>
    </MudMainContent>
</MudLayout>

@code {
    private bool _sombre = true;
}
