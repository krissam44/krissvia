@inherits LayoutComponentBase
@implements IDisposable

<MudThemeProvider IsDarkMode="_sombre" />
<MudPopoverProvider />
<MudDialogProvider />
<MudSnackbarProvider />

<MudLayout>
    <MudAppBar Elevation="1" Dense="true">
        @if (Connexion.Lieux.Count > 1)
        {
            @* Plusieurs installations : le nom du lieu affiché est le titre, et le menu pour passer à l'autre. *@
            <MudMenu AnchorOrigin="Origin.BottomLeft" TransformOrigin="Origin.TopLeft" aria-label="Changer de lieu">
                <ActivatorContent>
                    <div style="display:flex;align-items:center;gap:2px;cursor:pointer;">
                        <MudText Typo="Typo.h6" Style="font-weight:300;letter-spacing:1px;">@Connexion.Actif?.Nom</MudText>
                        <MudIcon Icon="@Icons.Material.Filled.ArrowDropDown" />
                    </div>
                </ActivatorContent>
                <ChildContent>
                    @foreach (var lieu in Connexion.Lieux)
                    {
                        var l = lieu;
                        <MudMenuItem Icon="@(l.Id == Connexion.Actif?.Id ? Icons.Material.Filled.Check : null)" OnClick="@(() => ChoisirAsync(l.Id))">@l.Nom</MudMenuItem>
                    }
                </ChildContent>
            </MudMenu>
        }
        else
        {
            <MudText Typo="Typo.h6" Style="font-weight:300;letter-spacing:1px;">@(Connexion.Actif?.Nom is { } nom && nom != "Krissvia" ? $"Krissvia · {nom}" : "Krissvia")</MudText>
        }
        <MudSpacer />
        <MudIconButton Icon="@(_sombre ? Icons.Material.Filled.LightMode : Icons.Material.Filled.DarkMode)"
                       Color="Color.Inherit" OnClick="@(() => _sombre = !_sombre)" aria-label="Thème" />
        <MudIconButton Icon="@Icons.Material.Filled.Settings" Color="Color.Inherit"
                       OnClick="@(() => Nav.NavigateTo("/reglages"))" aria-label="Lieux" />
    </MudAppBar>

    @* padding-bottom : la place de la barre de navigation fixe. *@
    <MudMainContent Style="padding-bottom:76px;">
        @* Une clé par lieu : changer de lieu recrée l'écran, qui relit tout chez le nouveau au lieu de garder ce qu'il
           avait chargé chez l'ancien. Pas l'écran des lieux, qui doit garder son message pendant qu'on en enregistre un. *@
        <div class="pa-3" @key="@(EstActif("/reglages") ? "reglages" : Connexion.Actif?.Id)">
            @Body
        </div>
    </MudMainContent>
</MudLayout>

@* Navigation basse, au pouce, comme l'appli de DomoMud. *@
<nav class="kv-nav">
    @foreach (var onglet in Onglets)
    {
        <button type="button" class="@($"kv-nav-item{(EstActif(onglet.Route) ? " actif" : "")}")" @onclick="@(() => Nav.NavigateTo(onglet.Route))">
            <MudIcon Icon="@onglet.Icone" Size="Size.Medium" />
            <span>@onglet.Libelle</span>
        </button>
    }
</nav>
