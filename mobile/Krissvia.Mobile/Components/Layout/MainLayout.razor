@inherits LayoutComponentBase
@implements IDisposable
@inject NavigationManager Nav

<MudThemeProvider IsDarkMode="_sombre" />
<MudPopoverProvider />
<MudDialogProvider />
<MudSnackbarProvider />

<MudLayout>
    <MudAppBar Elevation="1" Dense="true">
        <MudText Typo="Typo.h6" Style="font-weight:300;letter-spacing:1px;">Krissvia</MudText>
        <MudSpacer />
        <MudIconButton Icon="@(_sombre ? Icons.Material.Filled.LightMode : Icons.Material.Filled.DarkMode)"
                       Color="Color.Inherit" OnClick="@(() => _sombre = !_sombre)" aria-label="Thème" />
        <MudIconButton Icon="@Icons.Material.Filled.Settings" Color="Color.Inherit"
                       OnClick="@(() => Nav.NavigateTo("/reglages"))" aria-label="Connexion" />
    </MudAppBar>

    @* padding-bottom : la place de la barre de navigation fixe. *@
    <MudMainContent Style="padding-bottom:76px;">
        <div class="pa-3">
            @Body
        </div>
    </MudMainContent>
</MudLayout>

@* Navigation basse, au pouce, comme l'appli de DomoMud. *@
<nav class="kv-nav">
    @foreach (var onglet in Onglets)
    {
        <button type="button" class="@($"kv-nav-item{(EstActif(onglet.Route) ? " actif" : "")}")" @onclick="@(() => Nav.NavigateTo(onglet.Route))">
            <MudIcon Icon="@onglet.Icone" Size="Size.Medium" />
            <span>@onglet.Libelle</span>
        </button>
    }
</nav>

@code {
    private bool _sombre = true;

    private sealed record Onglet(string Route, string Libelle, string Icone);

    private static readonly Onglet[] Onglets =
    [
        new("/", "Thermostats", Icons.Material.Filled.ThermostatAuto),
        new("/radiateurs", "Radiateurs", Icons.Material.Filled.LocalFireDepartment),
        new("/sondes", "Sondes", Icons.Material.Filled.DeviceThermostat),
        new("/prises", "Prises", Icons.Material.Filled.Power),
        new("/alarme", "Alarme", Icons.Material.Filled.Security),
        new("/energie", "Énergie", Icons.Material.Filled.ElectricBolt),
    ];

    protected override void OnInitialized() => Nav.LocationChanged += Rafraichir;

    private void Rafraichir(object? sender, Microsoft.AspNetCore.Components.Routing.LocationChangedEventArgs e) => InvokeAsync(StateHasChanged);

    private bool EstActif(string route)
    {
        var courant = "/" + Nav.ToBaseRelativePath(Nav.Uri).Split('?')[0].TrimStart('/');
        return route == "/" ? courant == "/" : courant.StartsWith(route, StringComparison.OrdinalIgnoreCase);
    }

    public void Dispose() => Nav.LocationChanged -= Rafraichir;
}
