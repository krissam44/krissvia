# /etc/krissvia/krissvia.env — secrets du service, root:root en 600. Jamais versionné.
# installer.sh le crée au premier passage avec une clé tirée au hasard, et ne le touche plus ensuite.

# Clé de l'API publique (en-tête X-Api-Key) : Node-RED, appli mobile. Sans elle, l'API répond 503.
Api__Key=remplacer-par-une-longue-valeur-aleatoire

# Interpréteur des plugins Python, si ce n'est pas le python3 du système (environnement virtuel…).
#PluginHost__Runtimes__python=/opt/krissvia-venv/bin/python
