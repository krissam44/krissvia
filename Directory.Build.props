<Project>
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AnalysisLevel>latest</AnalysisLevel>
    <Deterministic>true</Deterministic>
    <!--
      La version de Krissvia : cœur, plugins C# et menu ⋮ (« Krissvia 1.2.1 · commit »). Chaque PR l'incrémente
      elle-même, avec son entrée dans CHANGELOG.md : le 2e chiffre pour une nouveauté, le 3e pour une correction
      ou un ajustement d'un écran existant.
      L'appli mobile a sa propre version (ApplicationDisplayVersion dans mobile/).
    -->
    <Version>1.3.0</Version>
    <!-- Règle du projet : zéro warning. Les alertes d'audit NuGet restent des warnings. -->
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <WarningsNotAsErrors>NU1901;NU1902;NU1903;NU1904</WarningsNotAsErrors>
  </PropertyGroup>
</Project>
