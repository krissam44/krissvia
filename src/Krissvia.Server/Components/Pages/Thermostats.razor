@page "/thermostats"
@implements IAsyncDisposable

<PageTitle>Thermostats · Krissvia</PageTitle>

<MudStack Row="true" AlignItems="AlignItems.Center" Justify="Justify.SpaceBetween" Class="mb-4">
    <MudText Typo="Typo.h5">Thermostats</MudText>
    <MudButton Href="/thermostats/nouveau" Variant="Variant.Filled" Color="Color.Primary" StartIcon="@Icons.Material.Filled.Add">Nouveau</MudButton>
</MudStack>

@foreach (var erreur in Service.LoadErrors)
{
    <MudAlert Severity="Severity.Error" Dense="true" Class="mb-2">Configuration illisible, thermostat écarté : @erreur</MudAlert>
}
@if (_erreurNavigateur is not null)
{
    <MudAlert Severity="Severity.Warning" Dense="true" Class="mb-2">Cartes indisponibles : @_erreurNavigateur</MudAlert>
}

@if (_cartes.Count == 0)
{
    <MudAlert Severity="Severity.Info">Aucun thermostat. Créez-en un : il lui faut une sonde de température et au moins un radiateur.</MudAlert>
}

@* Chaque carte est le widget du thermostat, le même que sur le tableau de bord : rempli par js/tableau-de-bord.js,
   tenu à jour par le flux en direct. Blazor ne dessine que le cadre vide, sinon chaque rendu l'effacerait. *@
<div class="kv-hote kv-thermostats" @ref="_racine">
    <div class="kv-bandeau-hors-ligne">Connexion au serveur perdue : les valeurs ne sont plus à jour. Reconnexion…</div>
    <div class="kv-thermostats-grille">
        @foreach (var carte in _cartes)
        {
            <div class="kv-carte" data-carte="@carte.Id" @key="carte.Id">
                @if (carte.EntityId is null)
                {
                    <div class="pa-4">
                        <MudText Typo="Typo.subtitle1">@carte.Nom</MudText>
                        <MudText Typo="Typo.body2" Class="mud-text-secondary">En attente de sa publication…</MudText>
                    </div>
                }
                else
                {
                    <div class="kv-carte-corps"></div>
                }
            </div>
        }
    </div>
</div>

<style>
    /* Comme l'écran Thermostats de DomoMud (lg="3") : quatre cartes par ligne sur grand écran, deux sur tablette, une sur téléphone. */
    .kv-thermostats-grille { display: grid; grid-template-columns: minmax(0, 1fr); gap: 16px; }
    @@media (min-width: 600px) { .kv-thermostats-grille { grid-template-columns: repeat(2, minmax(0, 1fr)); } }
    @@media (min-width: 1280px) { .kv-thermostats-grille { grid-template-columns: repeat(4, minmax(0, 1fr)); } }
    .kv-thermostats .kv-carte { height: 260px; }
</style>
