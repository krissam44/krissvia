@page "/parametres/comptes"

<PageTitle>Comptes · Krissvia</PageTitle>

<MudText Typo="Typo.h5" Class="mb-4">Comptes</MudText>

<MudPaper Elevation="1" Class="pa-4 mb-4 rounded-lg">
    <MudSimpleTable Dense="true" Elevation="0">
        <tbody>
            @foreach (var compte in Service.Users)
            {
                <tr @key="compte">
                    <td>@compte @(compte == _moi ? "(vous)" : "")</td>
                    <td style="width: 60px">
                        @if (compte != _moi)
                        {
                            <MudIconButton Icon="@Icons.Material.Filled.Delete" Color="Color.Error" Size="Size.Small"
                                           OnClick="() => SupprimerAsync(compte)" aria-label="@($"Supprimer {compte}")" />
                        }
                    </td>
                </tr>
            }
        </tbody>
    </MudSimpleTable>
</MudPaper>

<MudGrid>
    <MudItem xs="12" md="6">
        <MudPaper Elevation="1" Class="pa-4 rounded-lg">
            <MudText Typo="Typo.h6" Class="mb-2">Nouveau compte</MudText>
            <MudTextField @bind-Value="_nouvelIdentifiant" Label="Identifiant" Variant="Variant.Outlined" Margin="Margin.Dense" Class="mb-2" />
            <MudTextField @bind-Value="_nouveauMotDePasse" Label="Mot de passe" InputType="InputType.Password"
                          HelperText="@($"{Krissvia.Core.Accounts.AccountService.MinPasswordLength} caractères au moins")"
                          Variant="Variant.Outlined" Margin="Margin.Dense" />
            <MudButton Variant="Variant.Filled" Color="Color.Primary" Class="mt-3" OnClick="CreerAsync"
                       StartIcon="@Icons.Material.Filled.PersonAdd">Créer</MudButton>
        </MudPaper>
    </MudItem>
    <MudItem xs="12" md="6">
        <MudPaper Elevation="1" Class="pa-4 rounded-lg">
            <MudText Typo="Typo.h6" Class="mb-2">Mon mot de passe</MudText>
            <MudTextField @bind-Value="_actuel" Label="Mot de passe actuel" InputType="InputType.Password"
                          Variant="Variant.Outlined" Margin="Margin.Dense" Class="mb-2" />
            <MudTextField @bind-Value="_nouveau" Label="Nouveau mot de passe" InputType="InputType.Password"
                          Variant="Variant.Outlined" Margin="Margin.Dense" Class="mb-2" />
            <MudTextField @bind-Value="_confirmation" Label="Confirmation" InputType="InputType.Password"
                          Variant="Variant.Outlined" Margin="Margin.Dense" />
            <MudButton Variant="Variant.Filled" Color="Color.Primary" Class="mt-3" OnClick="ChangerAsync"
                       StartIcon="@Icons.Material.Filled.Key">Changer</MudButton>
        </MudPaper>
    </MudItem>
</MudGrid>
