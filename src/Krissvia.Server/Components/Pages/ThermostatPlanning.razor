@page "/thermostats/{Id}/planning"

<PageTitle>Planning · @Nom · Krissvia</PageTitle>

<MudButton Href="/thermostats" StartIcon="@Icons.Material.Filled.ArrowBack" Variant="Variant.Text" Class="mb-2">Thermostats</MudButton>

@if (_thermostat is null)
{
    <MudAlert Severity="Severity.Info">Aucun thermostat « @Id ».</MudAlert>
}
else
{
    <MudStack Row="true" AlignItems="AlignItems.Center" Justify="Justify.SpaceBetween" Class="mb-4">
        <MudText Typo="Typo.h5">Planning · @Nom</MudText>
        <MudChip T="string" Size="Size.Small" Color="@(_thermostat.ScheduleActive ? Color.Success : Color.Default)">
            @(_thermostat.ScheduleActive ? "Planning actif" : "Planning suspendu (mode choisi à la main)")
        </MudChip>
    </MudStack>

    @if (_erreur is not null)
    {
        <MudAlert Severity="Severity.Error" Class="mb-4">@_erreur</MudAlert>
    }

    <MudPaper Elevation="1" Class="pa-4 mb-4 rounded-lg">
        <MudText Typo="Typo.h6" Class="mb-1">Semaine</MudText>
        <MudText Typo="Typo.body2" Class="mud-text-secondary mb-3">
            Ce que fera le thermostat, calculé par la même règle que le moteur. Hors créneau : @LibellesThermostat.Mode(_modeParDefaut).
        </MudText>
        <div class="apercu">
            @foreach (var jour in Jours.Semaine)
            {
                <div class="ligne">
                    <span class="jour">@Abrege(jour)</span>
                    <div class="barre">
                        @foreach (var (debut, fin, mode) in Apercu(jour))
                        {
                            <div class="bloc" title="@($"{LibellesThermostat.Mode(mode)} de {Heure(debut)} à {Heure(fin)}")"
                                 style="@($"left:{Pourcent(debut)};width:{Pourcent(fin - debut)};background:{CouleursModes.Fond(mode)}")"></div>
                        }
                    </div>
                </div>
            }
            <div class="ligne graduation">
                <span class="jour"></span>
                <div class="barre">
                    @for (var h = 0; h <= 24; h += 6)
                    {
                        <span style="left:@(h * 100 / 24)%">@h h</span>
                    }
                </div>
            </div>
        </div>
        <div class="d-flex flex-wrap gap-3 mt-3">
            @foreach (var mode in LibellesThermostat.Modes)
            {
                <span class="legende"><i style="background:@CouleursModes.Fond(mode)"></i>@LibellesThermostat.Mode(mode)</span>
            }
        </div>
    </MudPaper>

    <MudPaper Elevation="1" Class="pa-4 mb-4 rounded-lg">
        <MudSelect T="ThermostatMode" @bind-Value="_modeParDefaut" Label="Mode hors créneau" Variant="Variant.Outlined" Margin="Margin.Dense"
                   Style="max-width: 320px" HelperText="S'applique à toute heure qu'aucun créneau ne couvre">
            @foreach (var mode in LibellesThermostat.Modes)
            {
                <MudSelectItem Value="mode">@LibellesThermostat.Mode(mode)</MudSelectItem>
            }
        </MudSelect>
    </MudPaper>

    @foreach (var jour in Jours.Semaine)
    {
        var creneaux = _jours[jour];
        <MudPaper Elevation="1" Class="pa-4 mb-3 rounded-lg" @key="jour">
            <MudStack Row="true" AlignItems="AlignItems.Center" Justify="Justify.SpaceBetween">
                <MudText Typo="Typo.subtitle1" Style="font-weight: 500">@Majuscule(Jours.Nom(jour))</MudText>
                <MudStack Row="true" Spacing="1">
                    <MudButton Size="Size.Small" StartIcon="@Icons.Material.Filled.Add" OnClick="() => Ajouter(jour)">Créneau</MudButton>
                    <MudMenu Label="Copier vers…" Size="Size.Small" Variant="Variant.Text" StartIcon="@Icons.Material.Filled.ContentCopy"
                             Disabled="@(creneaux.Count == 0)">
                        <MudMenuItem OnClick="() => Copier(jour, Jours.Semaine[..5])">Du lundi au vendredi</MudMenuItem>
                        <MudMenuItem OnClick="() => Copier(jour, Jours.Semaine[5..])">Samedi et dimanche</MudMenuItem>
                        <MudMenuItem OnClick="() => Copier(jour, Jours.Semaine)">Toute la semaine</MudMenuItem>
                    </MudMenu>
                </MudStack>
            </MudStack>

            @if (creneaux.Count == 0)
            {
                <MudText Typo="Typo.body2" Class="mud-text-secondary">Aucun créneau : @LibellesThermostat.Mode(_modeParDefaut) toute la journée.</MudText>
            }

            @foreach (var c in creneaux)
            {
                <div class="creneau mt-2" @key="c">
                    <MudTextField T="string" @bind-Value="c.Debut" Label="De" InputType="InputType.Time" Variant="Variant.Outlined" Margin="Margin.Dense" />
                    <MudTextField T="string" @bind-Value="c.Fin" Label="À" InputType="InputType.Time" Variant="Variant.Outlined" Margin="Margin.Dense" />
                    <MudSelect T="ThermostatMode" @bind-Value="c.Mode" Label="Mode" Variant="Variant.Outlined" Margin="Margin.Dense">
                        @foreach (var mode in LibellesThermostat.Modes)
                        {
                            <MudSelectItem Value="mode">@LibellesThermostat.Mode(mode)</MudSelectItem>
                        }
                    </MudSelect>
                    <MudIconButton Icon="@Icons.Material.Filled.Delete" Size="Size.Small" OnClick="() => creneaux.Remove(c)" aria-label="Supprimer le créneau" />
                    <MudText Typo="Typo.caption" Class="mud-text-secondary">
                        @if (Nuit(c))
                        {
                            @($"nuit : jusqu'au {Jours.Nom(Jours.Lendemain(jour))} matin")
                        }
                    </MudText>
                </div>
            }

            @foreach (var alerte in Alertes(jour))
            {
                <MudAlert Severity="Severity.Warning" Dense="true" Class="mt-2">@alerte</MudAlert>
            }
        </MudPaper>
    }

    <MudStack Row="true" Class="mt-4" Spacing="2">
        <MudButton Variant="Variant.Filled" Color="Color.Primary" StartIcon="@Icons.Material.Filled.Save" OnClick="EnregistrerAsync">Enregistrer</MudButton>
        <MudButton Variant="Variant.Text" OnClick="Recharger">Annuler les modifications</MudButton>
    </MudStack>
}

<style>
    .apercu .ligne { display: flex; align-items: center; margin-bottom: 4px; }
    .apercu .jour { width: 36px; font-size: .8rem; color: var(--mud-palette-text-secondary); }
    .apercu .barre { position: relative; flex: 1; height: 18px; border-radius: 4px; overflow: hidden; background: var(--mud-palette-background-gray); }
    .apercu .bloc { position: absolute; top: 0; bottom: 0; }
    .apercu .graduation .barre { height: 14px; background: none; overflow: visible; }
    .apercu .graduation span { position: absolute; transform: translateX(-50%); white-space: nowrap; font-size: .7rem; color: var(--mud-palette-text-secondary); }
    /* Une grille plutôt qu'une ligne souple : toutes les lignes s'alignent, qu'elles aient une mention « nuit » ou non. */
    .creneau { display: grid; grid-template-columns: 130px 130px 180px 40px 1fr; gap: 16px; align-items: center; }
    @@media (max-width: 700px) { .creneau { grid-template-columns: 1fr 1fr; } }
    .legende { font-size: .8rem; display: inline-flex; align-items: center; gap: 4px; }
    .legende i { width: 12px; height: 12px; border-radius: 3px; display: inline-block; }
</style>
