@page "/"
@page "/tableau-de-bord"
@page "/tableau-de-bord/{PageId}"
@implements IAsyncDisposable

<PageTitle>Tableau de bord · Krissvia</PageTitle>

<div class="d-flex align-center flex-wrap gap-2 mb-4">
    <MudText Typo="Typo.h5" Class="mr-2">Tableau de bord</MudText>

    @* Les pages : visibles dès qu'il y en a plusieurs, ou pour les gérer (DomoMud). *@
    @if (_edition || _pages.Count > 1)
    {
        @foreach (var pg in _pages)
        {
            var active = pg.Id == Page.Id;
            @if (_edition && active && _renommage)
            {
                <MudTextField T="string" Value="pg.Name" ValueChanged="RenommerPage" Immediate="true" Variant="Variant.Outlined"
                              Margin="Margin.Dense" Style="max-width: 180px" AutoFocus="true" OnBlur="() => _renommage = false"
                              aria-label="Nom de la page" />
            }
            else
            {
                <MudButton Size="Size.Small" Variant="@(active ? Variant.Filled : Variant.Outlined)" Color="@(active ? Color.Primary : Color.Default)"
                           OnClick="() => ChoisirPage(pg.Id)">@pg.Name</MudButton>
            }
        }
        @if (_edition)
        {
            <MudIconButton Icon="@Icons.Material.Filled.ChevronLeft" Size="Size.Small" OnClick="() => DeplacerPage(-1)"
                           Disabled="@(_pages[0].Id == Page.Id)" aria-label="Avancer la page" />
            <MudIconButton Icon="@Icons.Material.Filled.ChevronRight" Size="Size.Small" OnClick="() => DeplacerPage(1)"
                           Disabled="@(_pages[^1].Id == Page.Id)" aria-label="Reculer la page" />
            <MudIconButton Icon="@Icons.Material.Filled.EditNote" Size="Size.Small" OnClick="() => _renommage = true" aria-label="Renommer la page" />
            <MudIconButton Icon="@Icons.Material.Filled.Delete" Size="Size.Small" Color="Color.Error" OnClick="SupprimerPage"
                           Disabled="@(_pages.Count <= 1)" aria-label="Supprimer la page" />
            <MudButton Size="Size.Small" Variant="Variant.Text" Color="Color.Primary" StartIcon="@Icons.Material.Filled.Add" OnClick="AjouterPage">Page</MudButton>
        }
    }

    <MudSpacer />
    @if (_edition)
    {
        <MudButton Variant="Variant.Text" StartIcon="@Icons.Material.Filled.AutoAwesome" OnClick="ProposerAsync"
                   title="Ajoute à cette page une section par famille d'entités, chacune avec son widget">Proposer</MudButton>
        <MudButton Variant="Variant.Filled" Color="Color.Success" StartIcon="@Icons.Material.Filled.Save" OnClick="EnregistrerAsync">Enregistrer</MudButton>
        <MudButton Variant="Variant.Outlined" OnClick="Annuler">Annuler</MudButton>
    }
    else
    {
        <MudButton Variant="Variant.Text" StartIcon="@Icons.Material.Filled.Edit" OnClick="Modifier">Modifier</MudButton>
    }
</div>

@if (_erreurNavigateur is not null)
{
    <MudAlert Severity="Severity.Error" Class="mb-4">Le tableau de bord n'a pas pu démarrer dans le navigateur : @_erreurNavigateur</MudAlert>
}

@if (_edition)
{
    @foreach (var erreur in _catalogue.Errors)
    {
        <MudAlert Severity="Severity.Warning" Dense="true" Class="mb-2">Widget écarté : @erreur</MudAlert>
    }
}

@if (Page.Sections.Count == 0)
{
    <MudAlert Severity="Severity.Info" Class="mb-4">
        @if (_edition)
        {
            <span>Page vide. « Proposer » la remplit d'après vos entités (une section par famille), ou « Ajouter une section » pour la composer vous-même.</span>
        }
        else
        {
            <span>Page vide : « Modifier », puis « Proposer » ou « Ajouter une section ».</span>
        }
    </MudAlert>
}

@* La classe de la racine appartient au JS (kv-hors-ligne) : celle du mode édition va sur un élément intérieur, sinon
   chaque rendu de Blazor l'effacerait. *@
<div class="kv-tableau kv-hote" @ref="_racine">
    <div class="kv-bandeau-hors-ligne">Connexion au serveur perdue : les valeurs ne sont plus à jour. Reconnexion…</div>
    <div class="@(_edition ? "kv-edition" : "")">

    <div class="kv-sections">
    @for (var s = 0; s < Page.Sections.Count; s++)
    {
        var sec = Page.Sections[s];
        var premiere = s == 0;
        var derniere = s == Page.Sections.Count - 1;
        var largeurSection = sec.Cols ?? DashboardService.GridColumns;
        <section @key="sec.Id" class="@ClasseSection(sec, largeurSection)" style="@StyleSection(sec, largeurSection)">
            <div class="kv-section-entete">
                @if (_edition)
                {
                    <MudIconButton Icon="@Icons.Material.Filled.ArrowUpward" Size="Size.Small" Disabled="premiere"
                                   OnClick="() => DeplacerSection(sec.Id, -1)" aria-label="Monter la section" />
                    <MudIconButton Icon="@Icons.Material.Filled.ArrowDownward" Size="Size.Small" Disabled="derniere"
                                   OnClick="() => DeplacerSection(sec.Id, 1)" aria-label="Descendre la section" />
                }
                <MudIconButton Icon="@(sec.Collapsed ? Icons.Material.Filled.ChevronRight : Icons.Material.Filled.ExpandMore)" Size="Size.Small"
                               OnClick="() => BasculerSectionAsync(sec.Id)" aria-label="@(sec.Collapsed ? "Déplier la section" : "Replier la section")" />
                @if (_edition)
                {
                    <MudTextField T="string" Value="sec.Title" ValueChanged="t => RenommerSection(sec.Id, t)" Immediate="true"
                                  Variant="Variant.Text" Margin="Margin.Dense" Class="kv-section-titre-saisie" aria-label="Titre de la section" />
                }
                else
                {
                    <span class="kv-section-titre">@sec.Title</span>
                }
                <span class="kv-section-filet"></span>
                <span class="kv-section-compte">@sec.Cards.Count carte(s)</span>
                @if (_edition)
                {
                    <MudMenu Icon="@Icons.Material.Filled.AspectRatio" Size="Size.Small" Dense="true" aria-label="Largeur de la section">
                        @foreach (var largeur in LargeursSection)
                        {
                            <MudMenuItem OnClick="() => ElargirSection(sec.Id, largeur)"
                                         Icon="@(largeurSection == largeur ? Icons.Material.Filled.Check : null)">@LibelleSection(largeur)</MudMenuItem>
                        }
                    </MudMenu>
                    <MudMenu Icon="@Icons.Material.Filled.Palette" Size="Size.Small" Dense="true" aria-label="Couleur de la section">
                        @foreach (var (couleur, nom) in CouleursSection)
                        {
                            <MudMenuItem OnClick="() => ColorerSection(sec.Id, couleur)">
                                <span class="d-flex align-center gap-2">
                                    <MudIcon Icon="@(couleur is null ? Icons.Material.Outlined.Circle : Icons.Material.Filled.Circle)" Size="Size.Small" Style="@StyleCouleur(couleur)" />
                                    @nom
                                    @if (sec.Color == couleur)
                                    {
                                        <MudIcon Icon="@Icons.Material.Filled.Check" Size="Size.Small" />
                                    }
                                </span>
                            </MudMenuItem>
                        }
                    </MudMenu>
                    <MudIconButton Icon="@Icons.Material.Filled.Delete" Size="Size.Small" Color="Color.Error"
                                   OnClick="() => SupprimerSection(sec.Id)" aria-label="Supprimer la section et ses cartes" />
                }
            </div>

            @if (!sec.Collapsed)
            {
                <div class="kv-grille" @ondragover:preventDefault="true" @ondrop="() => Deposer(sec.Id, null)">
                    @for (var i = 0; i < sec.Cards.Count; i++)
                    {
                        var index = i;
                        var carte = sec.Cards[i];
                        var (colsCarte, rows) = Taille(carte);
                        var cols = Math.Min(colsCarte, largeurSection);
                        var resolue = Resoudre(carte);
                        var composant = Composant(resolue);
                        @* La clé change avec le widget : passer d'un Web Component à un widget Blazor recrée la carte, au lieu de
                           laisser l'élément du JS à côté du rendu de Blazor. *@
                        <div @key="(carte.Id, resolue.WidgetId)" class="kv-carte c@(cols) @Hauteurs.Classe(rows)" data-carte="@carte.Id" draggable="@(_edition ? "true" : "false")"
                             @ondragstart="() => _glissee = (sec.Id, carte.Id)"
                             @ondrop="() => Deposer(sec.Id, carte.Id)" @ondrop:stopPropagation="true">
                            @if (_edition)
                            {
                                <div class="kv-carte-outils">
                                    <MudIconButton Icon="@Icons.Material.Filled.ChevronLeft" Size="Size.Small" Disabled="@(index == 0)"
                                                   OnClick="() => DeplacerCarte(sec.Id, index, -1)" aria-label="Avancer la carte" />
                                    <MudIconButton Icon="@Icons.Material.Filled.ChevronRight" Size="Size.Small" Disabled="@(index == sec.Cards.Count - 1)"
                                                   OnClick="() => DeplacerCarte(sec.Id, index, 1)" aria-label="Reculer la carte" />
                                    <MudMenu Icon="@Icons.Material.Filled.AspectRatio" Size="Size.Small" Dense="true" aria-label="Largeur de la carte">
                                        @foreach (var (largeur, libelle) in Largeurs)
                                        {
                                            <MudMenuItem OnClick="() => Redimensionner(sec.Id, carte.Id, largeur)"
                                                         Icon="@(carte.Cols == largeur ? Icons.Material.Filled.Check : null)">@libelle</MudMenuItem>
                                        }
                                    </MudMenu>
                                    <MudMenu Icon="@Icons.Material.Filled.Height" Size="Size.Small" Dense="true" aria-label="Hauteur de la carte">
                                        <MudMenuItem OnClick="() => Rehausser(sec.Id, carte.Id, null)"
                                                     Icon="@(carte.Rows is null ? Icons.Material.Filled.Check : null)">Auto (taille du widget)</MudMenuItem>
                                        @foreach (var hauteur in Hauteurs.Toutes)
                                        {
                                            <MudMenuItem OnClick="() => Rehausser(sec.Id, carte.Id, hauteur)"
                                                         Icon="@(carte.Rows == hauteur ? Icons.Material.Filled.Check : null)">@Hauteurs.Libelle(hauteur)</MudMenuItem>
                                        }
                                    </MudMenu>
                                    <MudIconButton Icon="@Icons.Material.Filled.Settings" Size="Size.Small"
                                                   OnClick="() => ModifierCarteAsync(sec.Id, carte)" aria-label="Régler la carte" />
                                    <MudIconButton Icon="@Icons.Material.Filled.Delete" Size="Size.Small" Color="Color.Error"
                                                   OnClick="() => SupprimerCarte(sec.Id, carte.Id)" aria-label="Retirer la carte" />
                                </div>
                                @* Une carte étroite (1/12, ou 1/6 sur un écran moyen) n'a pas la place des six boutons : un seul menu,
                                   la taille se règle dans la roue dentée. Choisi par la largeur réelle de la carte (requête de
                                   conteneur), pas par sa largeur en douzièmes : la même carte est étroite ou non selon l'écran. *@
                                <div class="kv-carte-outils kv-carte-outils-compacts">
                                    <MudMenu Icon="@Icons.Material.Filled.MoreVert" Size="Size.Small" Dense="true" aria-label="Outils de la carte">
                                        <MudMenuItem Icon="@Icons.Material.Filled.ChevronLeft" Disabled="@(index == 0)"
                                                     OnClick="() => DeplacerCarte(sec.Id, index, -1)">Avancer</MudMenuItem>
                                        <MudMenuItem Icon="@Icons.Material.Filled.ChevronRight" Disabled="@(index == sec.Cards.Count - 1)"
                                                     OnClick="() => DeplacerCarte(sec.Id, index, 1)">Reculer</MudMenuItem>
                                        <MudMenuItem Icon="@Icons.Material.Filled.Settings"
                                                     OnClick="() => ModifierCarteAsync(sec.Id, carte)">Régler (taille, widget…)</MudMenuItem>
                                        <MudMenuItem Icon="@Icons.Material.Filled.Delete" IconColor="Color.Error"
                                                     OnClick="() => SupprimerCarte(sec.Id, carte.Id)">Retirer</MudMenuItem>
                                    </MudMenu>
                                </div>
                            }
                            @if (composant is not null)
                            {
                                <div class="kv-carte-blazor">
                                    @* Un widget Blazor qui échoue ne casse ni le tableau de bord ni le circuit (WIDGETS.md §1). *@
                                    <ErrorBoundary>
                                        <ChildContent>
                                            <DynamicComponent Type="composant" Parameters="@(new Dictionary<string, object?> { ["Context"] = Contexte(resolue) })" />
                                        </ChildContent>
                                        <ErrorContent Context="erreur">
                                            <div class="kv-carte-erreur" title="@erreur.Message">Widget « @resolue.Widget?.Manifest.Name » : @erreur.Message</div>
                                        </ErrorContent>
                                    </ErrorBoundary>
                                </div>
                            }
                            else
                            {
                                <div class="kv-carte-corps"></div>
                            }
                        </div>
                    }
                    @if (_edition)
                    {
                        <button type="button" class="kv-ajout c@(Math.Min(3, largeurSection)) h2" @onclick="() => AjouterCarteAsync(sec.Id)">
                            <MudIcon Icon="@Icons.Material.Filled.Add" Size="Size.Small" /> Ajouter une carte
                        </button>
                    }
                </div>
            }
        </section>
    }
    </div>

    @if (_edition)
    {
        <button type="button" class="kv-ajout-section" @onclick="AjouterSection">
            <MudIcon Icon="@Icons.Material.Filled.AddBox" Size="Size.Small" /> Ajouter une section
        </button>
    }
    </div>
</div>

<style>
    /* Cadre des cartes et variables du contrat : css/cartes.css, partagé avec l'écran Thermostats. */
    .kv-section { margin-bottom: 20px; min-width: 0; }
    /* Une section colorée : une teinte légère de sa couleur derrière l'en-tête et les cartes, et un liseré. Le mélange
       avec le transparent garde le fond lisible en thème clair comme en sombre. */
    .kv-section-teinte { padding: 4px 12px 12px; border-radius: 14px;
                         background: color-mix(in srgb, var(--kv-teinte) 12%, transparent);
                         border: 1px solid color-mix(in srgb, var(--kv-teinte) 35%, transparent); }
    .kv-section-teinte .kv-section-titre { color: color-mix(in srgb, var(--kv-teinte) 55%, var(--mud-palette-text-primary)); }
    /* Les sections dans la même grille de 12 que les cartes, et le même écart : une demi-section (6) a exactement les
       colonnes d'une demi-ligne de cartes, ses cartes de 1/12 gardent leur taille. Grand écran seulement : en dessous,
       chaque section reprend toute la ligne. */
    .kv-sections { display: grid; grid-template-columns: minmax(0, 1fr); column-gap: 12px; }
    .kv-section-entete { display: flex; align-items: center; gap: 4px; margin-bottom: 8px; min-height: 36px; }
    .kv-section-titre { font-size: 1.15rem; font-weight: 500; white-space: nowrap; }
    .kv-section-titre-saisie { flex: 0 1 260px; }
    .kv-section-filet { flex: 1; height: 1px; background: var(--mud-palette-lines-default); margin: 0 8px; }
    .kv-section-compte { font-size: .75rem; color: var(--mud-palette-text-secondary); white-space: nowrap; }

    /* Grille responsive. Sur grand écran, 12 colonnes comme MudGrid : une carte de 3 en met quatre par ligne. Sur
       tablette, 4 colonnes (une carte prend la moitié de sa largeur, arrondie au-dessus) ; sur téléphone, 2 (une
       demi-ligne jusqu'à 2, puis toute la ligne). Une carte plus large que l'écran est ramenée à sa largeur. */
    .kv-grille { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); grid-auto-rows: 53px; grid-auto-flow: dense; gap: 12px; }
    .kv-grille > * { grid-column: span 2; }
    .kv-grille .c1, .kv-grille .c2 { grid-column: span 1; }
    @@media (min-width: 600px) {
        .kv-grille { grid-template-columns: repeat(4, minmax(0, 1fr)); }
        .kv-grille > * { grid-column: span 4; }
        .kv-grille .c3, .kv-grille .c4 { grid-column: span 2; }
        .kv-grille .c5, .kv-grille .c6 { grid-column: span 3; }
    }
    @@media (min-width: 1280px) {
        .kv-sections { grid-template-columns: repeat(12, minmax(0, 1fr)); }
        .kv-section { grid-column: span 12; }
        .kv-section.s3 { grid-column: span 3; } .kv-section.s4 { grid-column: span 4; } .kv-section.s6 { grid-column: span 6; }
        .kv-section.s8 { grid-column: span 8; } .kv-section.s9 { grid-column: span 9; }
        .kv-section.s1 { grid-column: span 1; } .kv-section.s2 { grid-column: span 2; } .kv-section.s5 { grid-column: span 5; }
        .kv-section.s7 { grid-column: span 7; } .kv-section.s10 { grid-column: span 10; } .kv-section.s11 { grid-column: span 11; }
        /* Autant de colonnes que la section en a : une colonne de carte a la même largeur partout sur la page. */
        .kv-grille { grid-template-columns: repeat(var(--kv-cols, 12), minmax(0, 1fr)); }
        .kv-grille .c1 { grid-column: span 1; } .kv-grille .c2 { grid-column: span 2; } .kv-grille .c3 { grid-column: span 3; }
        .kv-grille .c4 { grid-column: span 4; } .kv-grille .c5 { grid-column: span 5; } .kv-grille .c6 { grid-column: span 6; }
        .kv-grille .c7 { grid-column: span 7; } .kv-grille .c8 { grid-column: span 8; } .kv-grille .c9 { grid-column: span 9; }
        .kv-grille .c10 { grid-column: span 10; } .kv-grille .c11 { grid-column: span 11; } .kv-grille .c12 { grid-column: span 12; }
    }
    /* La grille compte en demi-lignes : 53 px, et deux font une ligne de 118 px avec l'espacement (53 + 12 + 53). Une
       carte d'une ligne garde donc exactement sa hauteur d'avant les demi-lignes ; h3 = 1,5 ligne = 183 px (3 × 53 + 2 × 12). */
    .kv-grille .h2 { grid-row: span 2; } .kv-grille .h3 { grid-row: span 3; } .kv-grille .h4 { grid-row: span 4; }
    .kv-grille .h5 { grid-row: span 5; } .kv-grille .h6 { grid-row: span 6; } .kv-grille .h7 { grid-row: span 7; }
    .kv-grille .h8 { grid-row: span 8; }

    .kv-carte-blazor { flex: 1; min-height: 0; overflow: hidden; display: flex; flex-direction: column; }

    .kv-edition .kv-carte { outline: 2px dashed var(--mud-palette-lines-inputs); outline-offset: -2px; cursor: grab; }
    .kv-carte-outils { position: absolute; top: 2px; right: 2px; z-index: 2; display: flex; align-items: center; border-radius: 16px;
                       background: var(--mud-palette-surface); box-shadow: 0 1px 4px rgba(0,0,0,.2); }
    /* La barre complète fait 156 px : en dessous de 180 px de carte (une 1/12, une 1/6 sur un écran moyen), elle cède
       la place au menu « ⋮ ». Une 1/6 de grand écran (190 px) garde la barre. */
    .kv-edition .kv-carte { container-type: inline-size; }
    .kv-carte-outils-compacts { display: none; }
    @@container (max-width: 179px) {
        .kv-carte-outils:not(.kv-carte-outils-compacts) { display: none; }
        .kv-carte-outils-compacts { display: flex; }
    }
    .kv-ajout, .kv-ajout-section { display: flex; align-items: center; justify-content: center; gap: 6px; cursor: pointer;
                                   border: 2px dashed var(--mud-palette-lines-inputs); border-radius: 12px; background: transparent;
                                   color: var(--mud-palette-text-secondary); font: inherit; font-size: .85rem; }
    .kv-ajout:hover, .kv-ajout-section:hover { border-color: var(--mud-palette-primary); color: var(--mud-palette-primary); }
    .kv-ajout-section { width: 100%; padding: 12px; margin-top: 4px; font-weight: 500; letter-spacing: .03em; text-transform: uppercase; }

</style>
