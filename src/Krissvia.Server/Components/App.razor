<!DOCTYPE html>
<html lang="fr">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <base href="/" />
    <link href="https://fonts.googleapis.com/css?family=Roboto:300,400,500,700&display=swap" rel="stylesheet" />
    @* Icônes des widgets (celles des cartes de DomoMud) : une police, utilisable aussi dans le Shadow DOM. *@
    <link href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:opsz,wght,FILL,GRAD@@20..48,100..700,0..1,-50..200" rel="stylesheet" />
    <link href="_content/MudBlazor/MudBlazor.min.css" rel="stylesheet" />
    <link href="@Assets["css/cartes.css"]" rel="stylesheet" />
    <HeadOutlet @rendermode="ModeDeRendu" />
</head>
<body>
    <Routes @rendermode="ModeDeRendu" />
    <script src="_framework/blazor.web.js"></script>
    <script src="_content/MudBlazor/MudBlazor.min.js"></script>
    <script src="@Assets["js/fenetres.js"]"></script>
</body>
</html>

@code {
    [CascadingParameter] private HttpContext HttpContext { get; set; } = default!;

    // Les écrans d'accès (connexion, installation) restent en HTML simple : le cookie se pose dans une réponse HTTP.
    private IComponentRenderMode? ModeDeRendu => HttpContext.AcceptsInteractiveRouting() ? InteractiveServer : null;
}
