<MudDialog>
    <DialogContent>
        @if (_erreur is not null)
        {
            <MudAlert Severity="Severity.Warning" Dense="true" Class="mb-3">@_erreur</MudAlert>
        }

        <MudAutocomplete T="RegisteredEntity" Label="Entité" Value="_principale" ValueChanged="ChoisirEntite"
                         SearchFunc="ChercherAsync" ToStringFunc="@(e => e is null ? "" : $"{e.DisplayName} ({e.EntityId})")"
                         Variant="Variant.Outlined" Clearable="true" MaxItems="null" ResetValueOnEmptyText="true"
                         Adornment="Adornment.Start" AdornmentIcon="@Icons.Material.Filled.Search"
                         HelperText="Ce que la carte montre. Tapez une partie du nom ou de l'identifiant." />

        @if (_principale is not null)
        {
            <MudSelect T="string" Label="Widget" Value="_widget" ValueChanged="ChoisirWidget" Variant="Variant.Outlined" Class="mt-4"
                       HelperText="@(EstAuto ? "La carte suit le widget de l'entité : le changer dans l'écran Entités changera cette carte." : Widget?.Manifest.Description ?? "")">
                <MudSelectItem Value="@Auto">@LibelleAuto</MudSelectItem>
                @foreach (var w in _compatibles)
                {
                    <MudSelectItem Value="@w.Manifest.Id">@w.Manifest.Name@(w.IsStandard ? "" : $" — {w.Origin}")</MudSelectItem>
                }
            </MudSelect>
        }

        @if (Widget is { } widget)
        {
            @if (EstAuto && LiensAuto.Count > 1)
            {
                <MudText Typo="Typo.caption" Class="mud-text-secondary d-block mt-2">
                    Lié automatiquement : @string.Join(", ", LiensAuto.Skip(1).Select(l => $"{l.Key} → {l.Value}"))
                </MudText>
            }
            @foreach (var slot in EstAuto ? Enumerable.Empty<WidgetSlot>() : widget.Manifest.Slots.Skip(1))
            {
                <MudSelect T="string" Label="@Phrases.Majuscule(slot.Name)" @bind-Value="_liens[slot.Name]" Variant="Variant.Outlined" Class="mt-4"
                           Clearable="@(!slot.Required)" HelperText="@(slot.Required ? "Obligatoire" : "Facultatif")">
                    @foreach (var e in Entites.Where(e => WidgetCatalog.Score(slot, e) >= 0))
                    {
                        <MudSelectItem Value="@e.EntityId">@e.DisplayName (@e.EntityId)</MudSelectItem>
                    }
                </MudSelect>
            }

            <div class="d-flex gap-4 mt-4">
                <MudSelect T="int" Label="Largeur" @bind-Value="_cols" Variant="Variant.Outlined" HelperText="Part de la largeur d'un grand écran">
                    @foreach (var n in ChoixLargeurs)
                    {
                        <MudSelectItem Value="@n">@Largeurs.Libelle(n)</MudSelectItem>
                    }
                </MudSelect>
                <MudSelect T="int" Label="Hauteur" @bind-Value="_rows" Variant="Variant.Outlined" HelperText="En lignes">
                    @foreach (var n in Hauteurs)
                    {
                        <MudSelectItem Value="@n">@n</MudSelectItem>
                    }
                </MudSelect>
            </div>

            @if (_schema is not null && _reglages is not null)
            {
                <MudText Typo="Typo.subtitle2" Class="mt-4">Options</MudText>
                <SettingsEditor Champ="_schema" Valeur="_reglages" />
            }
        }
    </DialogContent>
    <DialogActions>
        <MudButton OnClick="() => Dialogue.Cancel()">Annuler</MudButton>
        <MudButton Variant="Variant.Filled" Color="Color.Primary" Disabled="@(Widget is null)" OnClick="Valider">@(Carte is null ? "Ajouter" : "Enregistrer")</MudButton>
    </DialogActions>
</MudDialog>
