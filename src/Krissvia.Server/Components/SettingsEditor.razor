@* Formulaire tiré de la description des réglages d'un plugin (plugin.json). Récursif : une sous-section par objet ; une
   liste s'affiche en tableau, chaque ligne se modifie dans une fenêtre (ListeReglages). Écrit directement dans l'objet
   JSON reçu. Les champs simples vont deux par ligne sur un écran large, puis les sections et les listes, dans l'ordre. *@

@if (ChampsSimples.Any())
{
    <MudGrid Spacing="2" Class="mb-1">
        @foreach (var champ in ChampsSimples)
        {
            <MudItem xs="12" md="@(champ.Multiline ? 12 : 6)">
                @switch (champ.Type)
                {
                    case SettingType.String when champ.Multiline:
                        <MudTextField T="string" Label="@champ.Label" HelperText="@champ.Description" Required="@(champ.Required && !Partage)"
                                      Lines="12" AutoGrow="true" MaxLines="30" Variant="Variant.Outlined" Margin="Margin.Dense"
                                      Style="font-family: ui-monospace, 'Cascadia Mono', Consolas, monospace; font-size: .82rem"
                                      Value="Texte(champ)" ValueChanged="v => Ecrire(champ, v)" />
                        break;

                    case SettingType.Boolean:
                        <MudSwitch T="bool" Label="@champ.Label" Color="Color.Primary"
                                   Value="Booleen(champ)" ValueChanged="v => Ecrire(champ, v)" />
                        @if (champ.Description is { } aideOui)
                        {
                            <MudText Typo="Typo.caption" Class="mud-text-secondary d-block">@aideOui</MudText>
                        }
                        break;

                    case SettingType.Integer:
                    case SettingType.Number:
                        <MudNumericField T="double?" Label="@champ.Label" HelperText="@champ.Description" Required="@(champ.Required && !Partage)"
                                         Min="champ.Minimum" Max="champ.Maximum" Variant="Variant.Outlined" Margin="Margin.Dense"
                                         Value="Nombre(champ)" ValueChanged="v => Ecrire(champ, v)" />
                        break;

                    case SettingType.String when champ.Entity is { } reference:
                        @* Contrat 0.3 : choisir l'entité, c'est l'autoriser pour ce plugin (docs/CONTRACT-V0.3.md §2). *@
                        <MudSelect T="string" Label="@champ.Label" Required="@(champ.Required && !Partage)" Clearable="true" Dense="true"
                                   HelperText="@AideEntite(champ, reference)" Variant="Variant.Outlined" Margin="Margin.Dense"
                                   Value="Texte(champ)" ValueChanged="v => Ecrire(champ, v)" ToStringFunc="NomEntite">
                            @foreach (var e in Entites(reference, Texte(champ)))
                            {
                                <MudSelectItem Value="e.EntityId">@e.DisplayName <span class="mud-text-secondary">· @e.EntityId</span></MudSelectItem>
                            }
                        </MudSelect>
                        break;

                    default:
                        <MudTextField T="string" Label="@champ.Label" HelperText="@champ.Description" Required="@(champ.Required && !Partage)"
                                      InputType="@(champ.Secret ? InputType.Password : InputType.Text)"
                                      Variant="Variant.Outlined" Margin="Margin.Dense"
                                      Value="Texte(champ)" ValueChanged="v => Ecrire(champ, v)" />
                        break;
                }
            </MudItem>
        }
    </MudGrid>
}

@foreach (var champ in Champ.Properties.Where(c => c.Type is SettingType.Object or SettingType.Array))
{
    <MudText Typo="Typo.subtitle1" Class="mt-4 mb-1"><b>@champ.Label</b></MudText>
    @if (champ.Description is { } aide)
    {
        <MudText Typo="Typo.caption" Class="mud-text-secondary d-block mb-1">@aide</MudText>
    }

    @if (champ.Type == SettingType.Object)
    {
        @if (champ.Shared == "mqtt")
        {
            <MudAlert Severity="Severity.Info" Dense="true" Class="my-1">
                Laisser l'adresse vide pour utiliser le broker commun (pastille MQTT de la barre du haut) ; la renseigner
                seulement pour un broker propre à ce plugin.
            </MudAlert>
        }
        <div class="pl-3">
            <SettingsEditor Champ="champ" Valeur="SousObjet(champ)" Partage="@(Partage || champ.Shared is not null)" />
        </div>
    }
    else
    {
        <ListeReglages Champ="champ" Liste="Liste(champ)" />
    }
}
